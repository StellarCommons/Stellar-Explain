// MAIN.TS
// ============================================================

/*
 *
 * main.ts
 *
 *
 * import {
 *   NestFactory,
 * } from '@nestjs/core';
 *
 *
 * async function bootstrap() {
 *
 *   const app =
 *     await NestFactory.create(
 *       AppModule,
 *     );
 *
 *   // -------------------------------------------------------
 *   // REQUEST ID
 *   // -------------------------------------------------------
 *
 *   app.use(
 *     (
 *       req,
 *       res,
 *       next,
 *     ) => {
 *
 *       const middleware =
 *         new RequestIdMiddleware();
 *
 *       middleware.use(
 *         req,
 *         res,
 *         next,
 *       );
 *     },
 *   );
 *
 *   // -------------------------------------------------------
 *   // GLOBAL ERROR BOUNDARY
 *   // -------------------------------------------------------
 *
 *   const errorLogger =
 *     app.get(
 *       ApplicationErrorLogger,
 *     );
 *
 *   app.useGlobalFilters(
 *     new GlobalExceptionFilter(
 *       errorLogger,
 *     ),
 *   );
 *
 *   await app.listen(
 *     process.env.PORT ?? 3000,
 *   );
 * }
 *
 *
 * bootstrap();
 *
 */

// ============================================================
// EXAMPLE RESPONSES
// ============================================================

/*
 *
 * ------------------------------------------------------------
 * SUCCESSFUL REQUEST
 * ------------------------------------------------------------
 *
 * GET /health
 *
 *
 * {
 *   "success": true,
 *   "status": "ok"
 * }
 *
 *
 *
 * ------------------------------------------------------------
 * EXPECTED HTTP ERROR
 * ------------------------------------------------------------
 *
 * GET /test/http-error
 *
 *
 * {
 *   "success": false,
 *   "statusCode": 400,
 *   "error": "Bad Request",
 *   "message": "Example request error",
 *   "path": "/test/http-error",
 *   "timestamp": "2026-08-31T10:00:00.000Z",
 *   "requestId": "req-123"
 * }
 *
 *
 *
 * ------------------------------------------------------------
 * UNEXPECTED ERROR
 * ------------------------------------------------------------
 *
 * GET /test/unhandled-error
 *
 *
 * {
 *   "success": false,
 *   "statusCode": 500,
 *   "error": "Internal Server Error",
 *   "message": "Internal server error",
 *   "path": "/test/unhandled-error",
 *   "timestamp": "2026-08-31T10:00:00.000Z",
 *   "requestId": "req-456"
 * }
 *
 *
 * The client NEVER receives:
 *
 *
 * {
 *   "stack": "...",
 *   "databasePassword": "...",
 *   "internalFilePath": "..."
 * }
 *
 */

// ============================================================
// UNIT TESTS
// ============================================================

describe(
  'GlobalExceptionFilter',
  () => {

    let filter:
      GlobalExceptionFilter;

    const logger =
      {
        log:
          jest.fn(),
      };

    beforeEach(
      () => {

        jest.clearAllMocks();

        filter =
          new GlobalExceptionFilter(
            logger as any,
          );
      },
    );

    // ========================================================
    // UNEXPECTED ERROR
    // ========================================================

    it(
      'converts uncaught errors into a 500 response',
      () => {

        const request =
          {
            method:
              'GET',

            originalUrl:
              '/users',

            url:
              '/users',

            ip:
              '127.0.0.1',

            headers:
              {
                'x-request-id':
                  'req-123',
              },

            user:
              {
                id:
                  'user-1',
              },
          } as Request;

        const response =
          {
            headersSent:
              false,

            status:
              jest.fn()
                .mockReturnThis(),

            json:
              jest.fn(),
          } as any;

        const host =
          {
            switchToHttp:
              () => ({
                getRequest:
                  () =>
                    request,

                getResponse:
                  () =>
                    response,
              }),
          } as any;

        filter.catch(
          new Error(
            'database password leaked here',
          ),
          host,
        );

        expect(
          response.status,
        ).toHaveBeenCalledWith(
          500,
        );

        expect(
          response.json,
        ).toHaveBeenCalledWith(
          expect.objectContaining({
            success:
              false,

            statusCode:
              500,

            message:
              'Internal server error',

            requestId:
              'req-123',
          }),
        );

        /*
         * The sensitive exception message must not be returned.
         */

        expect(
          response.json.mock.calls[0][0]
            .message,
        ).not.toContain(
          'database password',
        );
      },
    );

    // ========================================================
    // HTTP EXCEPTION
    // ========================================================

    it(
      'preserves expected HTTP exception status',
      () => {

        const request =
          {
            method:
              'POST',

            originalUrl:
              '/users',

            url:
              '/users',

            headers:
              {},
          } as Request;

        const response =
          {
            headersSent:
              false,

            status:
              jest.fn()
                .mockReturnThis(),

            json:
              jest.fn(),
          } as any;

        const host =
          {
            switchToHttp:
              () => ({
                getRequest:
                  () =>
                    request,

                getResponse:
                  () =>
                    response,
              }),
          } as any;

        filter.catch(
          new HttpException(
            'Invalid request',
            HttpStatus.BAD_REQUEST,
          ),
          host,
        );

        expect(
          response.status,
        ).toHaveBeenCalledWith(
          400,
        );

        expect(
          response.json,
        ).toHaveBeenCalledWith(
          expect.objectContaining({
            statusCode:
              400,

            message:
              'Invalid request',
          }),
        );
      },
    );

    // ========================================================
    // ERROR LOGGING
    // ========================================================

    it(
      'logs unexpected exceptions',
      () => {

        const request =
          {
            method:
              'GET',

            originalUrl:
              '/test',

            url:
              '/test',

            ip:
              '127.0.0.1',

            headers:
              {},
          } as Request;

        const response =
          {
            headersSent:
              false,

            status:
              jest.fn()
                .mockReturnThis(),

            json:
              jest.fn(),
          } as any;

        const host =
          {
            switchToHttp:
              () => ({
                getRequest:
                  () =>
                    request,

                getResponse:
                  () =>
                    response,
              }),
          } as any;

        const error =
          new Error(
            'Unexpected failure',
          );

        filter.catch(
          error,
          host,
        );

        expect(
          logger.log,
        ).toHaveBeenCalled();
      },
    );

    // ========================================================
    // HEADERS ALREADY SENT
    // ========================================================

    it(
      'does not attempt to overwrite an existing response',
      () => {

        const request =
          {
            method:
              'GET',

            originalUrl:
              '/stream',

            url:
              '/stream',

            headers:
              {},
          } as Request;

        const response =
          {
            headersSent:
              true,

            status:
              jest.fn(),

            json:
              jest.fn(),

            end:
              jest.fn(),
          } as any;

        const host =
          {
            switchToHttp:
              () => ({
                getRequest:
                  () =>
                    request,

                getResponse:
                  () =>
                    response,
              }),
          } as any;

        filter.catch(
          new Error(
            'stream failure',
          ),
          host,
        );

        expect(
          response.end,
        ).toHaveBeenCalled();

        expect(
          response.json,
        ).not.toHaveBeenCalled();
      },
    );
  },
);

// ============================================================
// ERROR HANDLING POLICY
// ============================================================

/*
 *
 * The global error boundary follows these rules:
 *
 *
 * 1. EXPECTED APPLICATION ERRORS
 *
 *    Use NestJS HttpException subclasses.
 *
 *    Example:
 *
 *      throw new NotFoundException(
 *        'User not found',
 *      );
 *
 *
 *
 * 2. UNEXPECTED ERRORS
 *
 *    Any unknown exception becomes HTTP 500.
 *
 *
 *
 * 3. LOGGING
 *
 *    Unexpected errors are logged with:
 *
 *      - stack trace
 *      - request ID
 *      - HTTP method
 *      - request path
 *      - IP address
 *      - authenticated user ID
 *      - timestamp
 *
 *
 *
 * 4. CLIENT RESPONSE
 *
 *    Clients receive a consistent structure.
 *
 *
 *
 * 5. SECURITY
 *
 *    Internal exception messages and stack traces are never
 *    returned for HTTP 500 errors.
 *
 *
 *
 * 6. REQUEST CORRELATION
 *
 *    Every request receives a request ID.
 *
 *    This makes it possible to correlate:
 *
 *
 *      Client error
 *           ↓
 *      requestId
 *           ↓
 *      application logs
 *           ↓
 *      database/service logs
 *
 *
 *
 * 7. RESPONSE SAFETY
 *
 *    If headers have already been sent, the filter does not
 *    attempt to write a second response.
 *
 */

// ============================================================
// RECOMMENDED PRODUCTION ARCHITECTURE
// ============================================================

/*
 *
 *
 *                    ┌──────────────────┐
 *                    │     Client       │
 *                    └────────┬─────────┘
 *                             │
 *                             ▼
 *                    ┌──────────────────┐
 *                    │ Request ID       │
 *                    │ Middleware       │
 *                    └────────┬─────────┘
 *                             │
 *                             ▼
 *                    ┌──────────────────┐
 *                    │ Authentication   │
 *                    └────────┬─────────┘
 *                             │
 *                             ▼
 *                    ┌──────────────────┐
 *                    │ Controllers /    │
 *                    │ Services         │
 *                    └────────┬─────────┘
 *                             │
 *                    exception│
 *                             ▼
 *                  ┌─────────────────────┐
 *                  │ Global Exception    │
 *                  │ Boundary            │
 *                  └──────────┬──────────┘
 *                             │
 *               ┌─────────────┴─────────────┐
 *               │                           │
 *               ▼                           ▼
 *       ┌──────────────┐            ┌──────────────┐
 *       │ Error Logs   │            │ Safe HTTP    │
 *       │ + Stack      │            │ Response     │
 *       └──────────────┘            └──────────────┘
 *
 */

